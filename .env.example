# Auth.js -- generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google Cloud -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud -> Credentials -> API key (restricted to the Sheets API).
# SERVER-SIDE ONLY. Deliberately not prefixed NEXT_PUBLIC_ -- it must never
# reach the browser.
GOOGLE_SHEETS_API_KEY=

# From the sheet URL: docs.google.com/spreadsheets/d/<THIS>/edit
GOOGLE_SHEET_ID=

# Tab name + range. A2 skips the header row.
GOOGLE_SHEET_RANGE=People!A2:F

# How long to hold sheet data in memory before refetching.
SHEETS_CACHE_TTL_MS=60000
